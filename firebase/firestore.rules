rules_version = '2';
// =============================================================================
// Caregivers Companion — Firestore security rules (SECURITY PHASE 4, the flip).
//
// Source of truth: /home/team/shared/security-design-proposal.md (owner-approved
// 2026-08-16), §4.1 rules sketch + §4.2 dead collections + §4.3 write
// validation + decisions D1–D9 (§7.4/§7.5). This file implements that contract
// EXACTLY, with two mechanical adjustments that make the sketch match the app's
// ACTUAL write flows (both documented inline where they occur; neither changes
// any access decision in the approved design):
//
//   (1) users/{uid} CREATE: the sketch required `activeGroupId is string` at
//       create, but the shipped app creates the profile WITHOUT a group context
//       (phase 1 auth) and merges `activeGroupId` in later (phase 2 org
//       provisioning — a second write). The create rule therefore locks the doc
//       to request.auth.uid, requires the doc's `uid` field (when present) to
//       match, and validates `activeGroupId` against real membership whenever
//       it appears in a create or update (D1: never a standalone allow).
//   (2) organizations/{orgId}/members/{memberId} READ: the sketch allowed
//       active members + uid self-reads only, which would deny the INVITEE the
//       design's own §3.4 flow (query pending invites by email, read the invite
//       doc, accept). The read rule adds the symmetric invitee clause — exactly
//       the email match the sketch's DELETE rule already grants for declines.
//
// DEPLOYMENT STATE: this file is PREPARATION ONLY. The deployed ruleset in the
// console is still allow-all-ish and is known to DIFFER from the git history
// (behavior-probed: mealEntries is 403 in production while git allowed it).
// The flip is gated: legacy claim (§5.1(c)) + owner sign-off first. See
// docs/security/rules-deploy.md (how to flip) and docs/security/rules-rollback.md
// (2-command rollback + pre-flip checklist). DO NOT deploy this file until the
// claim has run.
//
// Entitlements separation (D8): no plan/billing/member-cap/productTier field
// appears anywhere in these rules.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // helpers: org membership
    // Active members are uid-keyed and exist only while active (revocation =
    // delete), so existence IS the active-membership check — one cheap exists().
    // ---------------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function isActiveMember(orgId) {
      return signedIn() && orgId is string && exists(memberDoc(orgId));
    }

    // Single-get membership + role check (hot paths, read-budget friendly). A
    // missing member doc yields empty data -> .data.role is null -> null in any
    // role list -> false.
    function memberHasRole(orgId, roles) {
      return signedIn() && orgId is string && get(memberDoc(orgId)).data.role in roles;
    }

    function memberRole(orgId) {
      return get(memberDoc(orgId)).data.role; // only called after isActiveMember(orgId)
    }

    function isMemberWithRole(orgId, roles) {
      return isActiveMember(orgId) && memberRole(orgId) in roles;
    }

    // ---------------------------------------------------------------------------
    // helpers: group context (D1 — activeGroupId is a REQUEST/CONTEXT SELECTOR
    // ONLY, never authorization by itself; every use below independently
    // verifies membership / share / assignment.)
    // ---------------------------------------------------------------------------
    function activeGroupId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeGroupId;
    }

    // Switching context is legal only to an org the caller actively belongs to.
    function isValidGroupContext() {
      return request.resource.data.activeGroupId is string
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.activeGroupId)/members/$(request.auth.uid));
    }

    // ---------------------------------------------------------------------------
    // helpers: recipient access (owner org + grants + assignment scoping, D6)
    // NOTE (bug fix 2026-08-22): all helpers take the RECIPIENT DOC ID (a
    // string), never a Path. `rules.Path` has NO `.id` (only
    // rules.firestore.Resource does) — calling `.id` on a Path value resolves
    // to undefined, malformed the `get()` path interpolation, errored the rule,
    // and denied everything. Call sites that match the id directly
    // (careRecipients/{docId}, carechecklist/{parent}, assignments/{recipientId})
    // pass the match variable; ref-linked collections (careNotes / mealEntries
    // / symptomEntries) derive it via `get(<stored ref>).id` (a Resource).
    // ---------------------------------------------------------------------------
    function recipientOrgId(recipientId) {
      return get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId;
    }

    function orgDoc(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function isOrgKind(orgId, kind) {
      return orgId is string && exists(orgDoc(orgId)) && get(orgDoc(orgId)).data.kind == kind;
    }

    // Share doc: recipientShares/{recipientId}/grants/{granteeOrgId} (§3.3)
    function shareDoc(recipientId, granteeOrgId) {
      return /databases/$(database)/documents/recipientShares/$(recipientId)/grants/$(granteeOrgId);
    }

    function hasActiveShare(recipientId, granteeOrgId) {
      return granteeOrgId is string && exists(shareDoc(recipientId, granteeOrgId));
    }

    function shareLevel(recipientId, granteeOrgId) {
      return get(shareDoc(recipientId, granteeOrgId)).data.accessLevel; // null if no share
    }

    // ---------------------------------------------------------------------------
    // helpers: assignment-scoped org staff access (D6/D7)
    // Deterministic per (recipient, staff) path; the check is the caller's OWN
    // assignment. All three get()s hit the same doc -> cached, 1 read. D7 hard
    // cutoff: request.time is server time; absent bounds (core team) unbounded.
    // ---------------------------------------------------------------------------
    function assignmentDoc(recipientId) {
      return /databases/$(database)/documents/assignments/$(recipientId)/$(request.auth.uid);
    }

    function hasActiveAssignment(recipientId) {
      return exists(assignmentDoc(recipientId))
        && get(assignmentDoc(recipientId)).data.status == 'active'
        && (!('validFrom' in get(assignmentDoc(recipientId)).data)
            || request.time >= get(assignmentDoc(recipientId)).data.validFrom)
        && (!('validUntil' in get(assignmentDoc(recipientId)).data)
            || request.time <= get(assignmentDoc(recipientId)).data.validUntil);
    }

    // Kind-branched within-org visibility (D6): family -> any active member;
    // organization -> owner/admin, or caregiver/viewer with an active assignment.
    function canAccessRecipientInOrg(recipientId) {
      return memberHasRole(recipientOrgId(recipientId), ['owner', 'admin', 'caregiver', 'viewer'])
        && ( isOrgKind(recipientOrgId(recipientId), 'family')
             || memberHasRole(recipientOrgId(recipientId), ['owner', 'admin'])
             || ( memberHasRole(recipientOrgId(recipientId), ['caregiver', 'viewer'])
                  && hasActiveAssignment(recipientId) ) );
    }

    // Read access: within-org (kind-branched, common case) OR grantee with an
    // active share for the caller's active group. Grants are org-wide — the
    // share branch does not consult assignments (§3.2 note).
    function canAccessRecipientRef(recipientId) {
      return signedIn() && recipientId is string
        && ( canAccessRecipientInOrg(recipientId)
          || hasActiveShare(recipientId, activeGroupId()) );
    }

    // Query-compatible LIST check (2026-08-30): Firestore evaluates LIST query
    // rules WITHOUT loading documents — get() returns null even for existing
    // docs (dereferencing throws "Null value error"), while exists() on a
    // fully-specified path works. So a LIST rule cannot read the member doc's
    // role or the org doc's kind; it can only assert active membership via
    // exists() on organizations/{orgId}/members/{request.auth.uid}.
    //
    // Consequence (v1): the careRecipients LIST rule lets any ACTIVE MEMBER of
    // the recipient's org list recipients — correct for family (D6: any active
    // member). Professional caregiver/viewer assignment-scoped LISTING is
    // deferred (needs a collectionGroup query on assignments — future work).
    // Single-doc GETs keep the FULL kind-branched + share + assignment gate via
    // canAccessRecipientRef (get() is fine for single-doc reads).
    function canListRecipientsInOrg(orgId) {
      return signedIn() && orgId is string && exists(memberDoc(orgId));
    }

    // Write access to recipient data: family -> member role >= caregiver;
    // organization -> owner/admin, or assigned caregiver; grantee -> share
    // accessLevel 'caregiver' (D2 default).
    function canWriteInOrg(recipientId) {
      return memberHasRole(recipientOrgId(recipientId), ['owner', 'admin', 'caregiver'])
        && ( isOrgKind(recipientOrgId(recipientId), 'family')
             || memberHasRole(recipientOrgId(recipientId), ['owner', 'admin'])
             || ( memberHasRole(recipientOrgId(recipientId), ['caregiver'])
                  && hasActiveAssignment(recipientId) ) );
    }

    function canWriteRecipientData(recipientId) {
      return signedIn() && recipientId is string
        && ( canWriteInOrg(recipientId)
          || shareLevel(recipientId, activeGroupId()) == 'caregiver' );
    }

    // ---------------------------------------------------------------------------
    // users/{uid} — self only. Adjustment (1): the create rule accepts the
    // phase-1 profile create (uid/name/email/createdAt, no context) and the
    // phase-2 set-merge that adds activeGroupId (which may be a create if the
    // profile write raced), validating context against real membership in both.
    // ---------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('activeGroupId' in request.resource.data) || isValidGroupContext());
      // Self-update; changing activeGroupId is allowed only to an org the user
      // actively belongs to (D1 — validated against the members subcollection).
      allow update: if signedIn() && request.auth.uid == uid
        && ( !('activeGroupId' in request.resource.data.diff(resource.data).affectedKeys())
             || isValidGroupContext() );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // organizations/{orgId}
    // D8: product metadata (plan, memberCap, displayName, productTier) is NOT
    // referenced anywhere — entitlements live outside authorization.
    // ---------------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isActiveMember(orgId);
      // Any signed-in user may create an org (becomes its owner via the member
      // doc below). kind is validated at create (D5: the app writes 'family').
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.kind in ['family', 'organization'];
      allow update: if isMemberWithRole(orgId, ['owner', 'admin']);
      allow delete: if isMemberWithRole(orgId, ['owner']); // owner-only transfer/delete
    }

    // ---------------------------------------------------------------------------
    // organizations/{orgId}/members/{memberId}
    // Active members keyed by uid; pending invites keyed by lowercase email with
    // status 'invited'. Adjustment (2): invitees may read invites addressed to
    // their own auth email (the design's §3.4 accept flow); the delete rule's
    // email match is the design's own decline clause.
    // ---------------------------------------------------------------------------
    match /organizations/{orgId}/members/{memberId} {
      allow read: if isActiveMember(orgId)
        || request.auth.uid == memberId
        || (resource.data.status == 'invited'
            && resource.data.invitedEmail == request.auth.token.email);
      // Founder self-doc (org doc must already exist — sequential write, §2.1);
      // owner/admin invite (role never 'owner'); invitee self-accept (role
      // locked to the invite).
      allow create: if signedIn() && (
          // founder
          (request.resource.data.uid == request.auth.uid
           && request.resource.data.role == 'owner'
           && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid)
        || // owner/admin invite
          (isMemberWithRole(orgId, ['owner', 'admin'])
           && request.resource.data.status == 'invited'
           && request.resource.data.role in ['admin', 'caregiver', 'viewer'])
        || // invitee self-accept: uid-keyed active doc, role locked to the invite
          (request.auth.uid == memberId
           && request.resource.data.uid == request.auth.uid
           && request.resource.data.status == 'active'
           && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.token.email))
           && request.resource.data.role
              == get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.token.email)).data.role)
      );
      // Owner/admin manage roles & status; admins cannot create owners.
      allow update: if isMemberWithRole(orgId, ['owner'])
        || (isMemberWithRole(orgId, ['admin']) && request.resource.data.role != 'owner');
      // Owner/admin revoke; invitee may delete own pending invite (decline /
      // accept-batch cleanup).
      allow delete: if isMemberWithRole(orgId, ['owner', 'admin'])
        || (resource.data.status == 'invited'
            && resource.data.invitedEmail == request.auth.token.email);
    }

    // ---------------------------------------------------------------------------
    // assignments/{recipientId}/{staffUid} — model-ready but EMPTY in v1 (D9).
    // Professional orgs only (D6/D7): owner/admin manage; staff read their own
    // assignment (powers the future "my recipients" collectionGroup query).
    // Write validation per §4.3.
    // ---------------------------------------------------------------------------
    match /assignments/{recipientId}/{staffUid} {
      allow read: if request.auth.uid == staffUid
        || isMemberWithRole(
             get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
             ['owner', 'admin']);
      allow create: if isMemberWithRole(
                        get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
                        ['owner', 'admin'])
        && request.resource.data.staffUid == staffUid
        && request.resource.data.orgId
           == get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId
        && isOrgKind(request.resource.data.orgId, 'organization')
        && request.resource.data.teamType in ['core', 'temporary']
        && request.resource.data.status == 'active'
        && request.resource.data.assignedBy == request.auth.uid
        && (!('validUntil' in request.resource.data)
            || request.resource.data.validUntil > request.time)
        && (!('validFrom' in request.resource.data) || !('validUntil' in request.resource.data)
            || request.resource.data.validFrom < request.resource.data.validUntil);
      // Revocation = delete (or status -> 'removed' via update); immediate
      // either way. Update is owner/admin only (D7 bounds are create-time
      // validation; time still enforced on the READ path by hasActiveAssignment).
      allow update: if isMemberWithRole(
                        get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
                        ['owner', 'admin']);
      allow delete: if isMemberWithRole(
                        get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
                        ['owner', 'admin']);
    }

    // ---------------------------------------------------------------------------
    // recipientShares/{recipientId}/grants/{granteeOrgId} — cross-group grants
    // (D4: model/rules-only, no UI yet). ONLY the owner of the recipient's org
    // creates/updates/revokes grants. Read: owner-org members only (management
    // surface, §4.1) — grantee access is granted implicitly via exists() in
    // canAccessRecipientRef.
    // ---------------------------------------------------------------------------
    match /recipientShares/{recipientId}/grants/{granteeOrgId} {
      allow read: if isActiveMember(recipientOrgId(recipientId));
      allow create, update, delete:
        if isMemberWithRole(
             get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
             ['owner'])
          && request.resource.data.accessLevel in ['caregiver', 'viewer'];
    }

    // ---------------------------------------------------------------------------
    // careRecipients
    // ---------------------------------------------------------------------------
    match /careRecipients/{docId} {
      // Create: the writer must be an ACTIVE MEMBER of the org the doc claims
      // (D1 — rules independently verify membership via get() on the members
      // doc; activeGroupId is never a standalone allow). orgId required.
      allow create: if isActiveMember(request.resource.data.orgId)
        && request.resource.data.orgId is string;
      // Read split (2026-08-30): single-doc GET keeps the FULL gate (kind-branched
      // within-org + grantee share + caregiver/viewer assignment), all of which
      // use get() — fine for single-doc reads. LIST queries (careRecipients where
      // orgId == activeGroup) use an exists()-only check, because Firestore does
      // not load documents during query evaluation (get() throws "Null value
      // error" there).
      allow get: if canAccessRecipientRef(docId);
      allow list: if canListRecipientsInOrg(resource.data.orgId);
      // Owner-org caregiver+ (kind-branched) or caregiver-level grantee;
      // orgId is immutable under rules (§4.3) — no transfer in v1 (grants are
      // the v1 mechanism for provider access).
      allow update: if request.resource.data.orgId == resource.data.orgId
        && canWriteRecipientData(docId);
      // Q5: delete = owner of the recipient's org only.
      allow delete: if isMemberWithRole(resource.data.orgId, ['owner']);
    }

    // ---------------------------------------------------------------------------
    // carechecklist (subcollection of careRecipients)
    // NOTE: the old collectionGroup catch-all
    //   match /{path=**}/carechecklist/{document} { allow read: if true; }
    // is REMOVED — it bypassed the parent-org gate. Access derives from the
    // PARENT recipient doc.
    // ---------------------------------------------------------------------------
    match /careRecipients/{parent}/carechecklist/{docId} {
      // `parent` is the matched careRecipients doc id — pass it directly (a
      // Path has no `.id`).
      allow read:   if canAccessRecipientRef(parent);
      allow create: if canWriteRecipientData(parent);
      allow update, delete:
        if canWriteRecipientData(parent);
    }

    // ---------------------------------------------------------------------------
    // careNotes — ref-linked via careRecipientRef
    // The stored field is a DocumentReference; we cannot call `.id` on it (a
    // Reference has no `.id`), so we derive the recipient id from the referenced
    // doc via get(<ref>).id — a rules.firestore.Resource, which DOES expose
    // `.id` — then reuse the same string-id helpers. This preserves the full
    // parent-org / share / assignment gate.
    // ---------------------------------------------------------------------------
    match /careNotes/{docId} {
      allow read:   if canAccessRecipientRef(get(resource.data.careRecipientRef).id);
      allow create: if canWriteRecipientData(get(request.resource.data.careRecipientRef).id);
      allow update, delete:
        if canWriteRecipientData(get(resource.data.careRecipientRef).id);
    }

    // ---------------------------------------------------------------------------
    // mealEntries — ref-linked via patientRef (see careNotes note above)
    // ---------------------------------------------------------------------------
    match /mealEntries/{docId} {
      // Reads are recipient-scoped for BOTH get and list (2026-11-19): the same
      // full canAccessRecipientRef gate (within-org kind-branched + grantee
      // share + caregiver/viewer assignment), resolved from the document's own
      // patientRef. A get() inside a LIST rule resolves fine here BECAUSE the
      // app's query must constrain patientRef (the field the rule reads) — that
      // is what makes this read recipient-scoped and query-compatible at once
      // (verified in the emulator 2026-11-18). The earlier exists()-only orgId
      // check is gone because it required a stored orgId on every document, and
      // legacy meal docs carry only patientRef — they were invisible.
      // CONSEQUENCE: there is no org-wide meal query; the dashboard filters
      // `where('patientRef', == selectedRecipient)` and nothing else.
      allow get:    if canAccessRecipientRef(get(resource.data.patientRef).id);
      allow list:   if canAccessRecipientRef(get(resource.data.patientRef).id);
      // orgId is still required on create (unchanged): the LIST rule no longer
      // reads it, but every new meal keeps carrying the org its writer was in,
      // exactly like careRecipients / medications do. Legacy docs without it
      // stay valid for reads and updates.
      allow create: if canWriteRecipientData(get(request.resource.data.patientRef).id)
        && request.resource.data.orgId is string;
      allow update, delete:
        if canWriteRecipientData(get(resource.data.patientRef).id);
    }

    // ---------------------------------------------------------------------------
    // symptomEntries — ref-linked via patientRef (see careNotes note above)
    // ---------------------------------------------------------------------------
    match /symptomEntries/{docId} {
      allow read:   if canAccessRecipientRef(get(resource.data.patientRef).id);
      allow create: if canWriteRecipientData(get(request.resource.data.patientRef).id);
      allow update, delete:
        if canWriteRecipientData(get(resource.data.patientRef).id);
    }

    // ---------------------------------------------------------------------------
    // medications — ref-linked via careRecipientRef (see careNotes note above)
    // Enabled 2026-08-31: was a dead collection with an explicit deny; the
    // medication tracker's "Taken" toggle now reads + updates it. It carries a
    // careRecipientRef DocumentReference, so it uses the same recipient-org /
    // share / assignment gate as careNotes — a one-block swap as the dead
    // collections comment describes. Enabling it does not loosen any other
    // collection.
    // ---------------------------------------------------------------------------
    match /medications/{docId} {
      // Reads are recipient-scoped for BOTH get and list (2026-11-19, mirrors
      // vitalLogs / waterLogs / appointments): the same full
      // canAccessRecipientRef gate (within-org kind-branched + grantee share +
      // caregiver/viewer assignment), resolved from the document's own
      // careRecipientRef. A get() inside a LIST rule resolves fine here BECAUSE
      // the app's query must constrain careRecipientRef (the field the rule
      // reads) — verified in the emulator 2026-11-18. The earlier exists()-only
      // orgId check is gone because it required a stored orgId on every
      // document, and legacy medication docs carry only careRecipientRef — they
      // were invisible in the tracker and the dose card.
      // CONSEQUENCE: there is no org-wide medication query; every read filters
      // `where('careRecipientRef', == selectedRecipient)`.
      allow get:    if canAccessRecipientRef(get(resource.data.careRecipientRef).id);
      allow list:   if canAccessRecipientRef(get(resource.data.careRecipientRef).id);
      // orgId is still required on create (unchanged): the LIST rule no longer
      // reads it, but every new medication keeps carrying the org its writer was
      // in, exactly like careRecipients does. Legacy docs without it stay valid
      // for reads and updates.
      allow create: if canWriteRecipientData(get(request.resource.data.careRecipientRef).id)
        && request.resource.data.orgId is string;
      allow update, delete:
        if canWriteRecipientData(get(resource.data.careRecipientRef).id);
    }

    // ---------------------------------------------------------------------------
    // vitalLogs — enabled 2026-11-13 (owner-approved v2 design, proposal
    // vitals-rules-proposal-v2-2026-11-13.md §2). Ref-linked via careRecipientRef.
    // Was a dead collection with an explicit deny; the block below is that one
    // deny line replaced by the recipient-scoped gate.
    //
    // READS are recipient-scoped for BOTH get and list: the same full
    // canAccessRecipientRef gate (within-org kind-branched + grantee share +
    // caregiver/viewer assignment). A get() inside a LIST rule resolves fine
    // here BECAUSE the app's query must constrain careRecipientRef — that is
    // what makes this read recipient-scoped and query-compatible at once.
    // CONSEQUENCE: there is no org-wide / all-recipients vitals query. A bare
    // collection list, or a `where('orgId', ==)` only query, is DENIED. The
    // vitals screen and the (deferred) doctor report must filter
    // `where('careRecipientRef', == selectedRecipient)`.
    //
    // WRITES: create requires an orgId strictly matching the recipient's own
    // org, a non-future logDateTime, and loggedByUid == the caller. orgId,
    // loggedByUid and careRecipientRef are immutable on update; logDateTime is
    // re-validated. Edits/deletes are the author's, or an owner/admin of the
    // recipient's org — resolved from careRecipientRef, never from the stored
    // orgId, so a stale orgId can never be used to escalate.
    // ---------------------------------------------------------------------------
    match /vitalLogs/{docId} {
      allow get:    if canAccessRecipientRef(get(resource.data.careRecipientRef).id);
      allow list:   if canAccessRecipientRef(get(resource.data.careRecipientRef).id);

      allow create: if request.resource.data.careRecipientRef is path
        && request.resource.data.orgId is string
        && request.resource.data.logDateTime is timestamp
        && request.resource.data.logDateTime <= request.time
        && request.resource.data.loggedByUid == request.auth.uid
        && canWriteRecipientData(get(request.resource.data.careRecipientRef).id)
        && request.resource.data.orgId
             == recipientOrgId(get(request.resource.data.careRecipientRef).id);

      allow update: if canWriteRecipientData(get(resource.data.careRecipientRef).id)
        && request.resource.data.careRecipientRef == resource.data.careRecipientRef
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.loggedByUid == resource.data.loggedByUid
        && request.resource.data.logDateTime is timestamp
        && request.resource.data.logDateTime <= request.time
        && ( resource.data.loggedByUid == request.auth.uid
             || memberHasRole(recipientOrgId(get(resource.data.careRecipientRef).id),
                              ['owner', 'admin']) );

      allow delete: if canWriteRecipientData(get(resource.data.careRecipientRef).id)
        && ( resource.data.loggedByUid == request.auth.uid
             || memberHasRole(recipientOrgId(get(resource.data.careRecipientRef).id),
                              ['owner', 'admin']) );
    }

    // ---------------------------------------------------------------------------
    // waterLogs — enabled 2026-11-13 (owner-approved water tracking unit,
    // proposal water-tracking-proposal-2026-11-13.md §2/§3). One document per
    // individually timestamped intake, ref-linked via careRecipientRef.
    //
    // READS are recipient-scoped for BOTH get and list, exactly as vitalLogs:
    // the app's query must constrain careRecipientRef, so a bare collection
    // list or an `orgId`-only query is DENIED.
    //
    // WRITES: create requires a positive amount, a canonical amountFlOz, a
    // known unit ('fl_oz' now, 'mL' already accepted so mL needs no rules
    // change), a non-future intakeAt, loggedByUid == the caller, and an orgId
    // strictly matching the recipient's own org. orgId, loggedByUid and
    // careRecipientRef are immutable on update; intakeAt is re-validated.
    // Edits/deletes are the author's (which is what makes the dashboard's
    // Undo work) or an owner/admin of the recipient's org — resolved from
    // careRecipientRef, never from the stored orgId.
    // ---------------------------------------------------------------------------
    match /waterLogs/{docId} {
      allow get:    if canAccessRecipientRef(get(resource.data.careRecipientRef).id);
      allow list:   if canAccessRecipientRef(get(resource.data.careRecipientRef).id);

      allow create: if request.resource.data.careRecipientRef is path
        && request.resource.data.orgId is string
        && request.resource.data.intakeAt is timestamp
        && request.resource.data.intakeAt <= request.time
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amountFlOz is number
        && request.resource.data.unit in ['fl_oz', 'mL']
        && request.resource.data.loggedByUid == request.auth.uid
        && canWriteRecipientData(get(request.resource.data.careRecipientRef).id)
        && request.resource.data.orgId
             == recipientOrgId(get(request.resource.data.careRecipientRef).id);

      allow update: if canWriteRecipientData(get(resource.data.careRecipientRef).id)
        && request.resource.data.careRecipientRef == resource.data.careRecipientRef
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.loggedByUid == resource.data.loggedByUid
        && request.resource.data.intakeAt is timestamp
        && request.resource.data.intakeAt <= request.time
        && ( resource.data.loggedByUid == request.auth.uid
             || memberHasRole(recipientOrgId(get(resource.data.careRecipientRef).id),
                              ['owner', 'admin']) );

      allow delete: if canWriteRecipientData(get(resource.data.careRecipientRef).id)
        && ( resource.data.loggedByUid == request.auth.uid
             || memberHasRole(recipientOrgId(get(resource.data.careRecipientRef).id),
                              ['owner', 'admin']) );
    }

    // ---------------------------------------------------------------------------
    // appointments — enabled 2026-11-16 (owner-approved appointments +
    // calendar unit, proposal appointments-calendar-proposal-2026-11-15.md §2–§4).
    // Was a dead collection with an explicit deny; the block below is that one
    // deny line replaced by the same recipient-scoped gate vitalLogs/waterLogs
    // use, so there is one shape to reason about.
    //
    // READS are recipient-scoped for BOTH get and list, exactly as vitalLogs:
    // the app's query must constrain careRecipientRef, so a bare collection list
    // or an `orgId`-only query is DENIED. The read rules deliberately never
    // mention orgId or createdByUid (see LEGACY below).
    //
    // WRITES: create requires the author's own uid, a non-empty title, a start
    // time, an end not before the start, a server-stamped createdAt and an orgId
    // strictly equal to the recipient's own org. careRecipientRef, orgId and
    // createdByUid are immutable after create. Edits/deletes are the author's or
    // an owner/admin of the recipient's org, resolved from careRecipientRef and
    // never from the stored orgId, so a stale orgId can never be used to
    // escalate.
    //
    // FUTURE DATES ARE ALLOWED on create and update — the whole point of an
    // appointment, and the one deliberate difference from vitalLogs/waterLogs.
    // Only createdAt/updatedAt are pinned to the server time.
    //
    // LEGACY COMPATIBILITY (owner requirement, 2026-11-16). Appointments created
    // before orgId/createdByUid existed carry neither field. They must stay
    // readable and editable under these rules, and must never be silently
    // rewritten:
    //   * READ never requires either field, so a legacy record reads exactly
    //     like a new one (and appears in the recipient-scoped list/month query).
    //   * UPDATE tolerates a MISSING field on the stored document: it may stay
    //     absent (the record is left exactly as it was) or be filled in with a
    //     value these rules verify to be true — the recipient's real org, or the
    //     caller's own uid. A stored value is never overwritten.
    //   * A legacy record has no recorded author to compare against, so BOTH its
    //     update and its delete require owner/admin of the recipient's org
    //     (owner decision 2026-11-16). There is deliberately NO fallback to
    //     plain recipient write access: a caregiver cannot edit or delete a
    //     record that records no author.
    // ---------------------------------------------------------------------------
    match /appointments/{docId} {
      allow get:    if canAccessRecipientRef(get(resource.data.careRecipientRef).id);
      allow list:   if canAccessRecipientRef(get(resource.data.careRecipientRef).id);

      allow create: if request.resource.data.careRecipientRef is path
        && request.resource.data.orgId is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.appointmentTitle is string
        && request.resource.data.appointmentTitle.size() > 0
        && request.resource.data.appointmentDateTime is timestamp
        && (!('endDateTime' in request.resource.data)
             || request.resource.data.endDateTime >= request.resource.data.appointmentDateTime)
        && request.resource.data.createdAt == request.time
        && canWriteRecipientData(get(request.resource.data.careRecipientRef).id)
        && request.resource.data.orgId
             == recipientOrgId(get(request.resource.data.careRecipientRef).id);

      allow update: if canWriteRecipientData(get(resource.data.careRecipientRef).id)
        && request.resource.data.careRecipientRef == resource.data.careRecipientRef
        // orgId / createdByUid: immutable once stored; on a legacy record either
        // still absent, or added with the verified-true value.
        && (!('orgId' in resource.data)
             ? (!('orgId' in request.resource.data)
                || request.resource.data.orgId
                     == recipientOrgId(get(resource.data.careRecipientRef).id))
             : request.resource.data.orgId == resource.data.orgId)
        && (!('createdByUid' in resource.data)
             ? (!('createdByUid' in request.resource.data)
                || request.resource.data.createdByUid == request.auth.uid)
             : request.resource.data.createdByUid == resource.data.createdByUid)
        && request.resource.data.appointmentTitle is string
        && request.resource.data.appointmentTitle.size() > 0
        && request.resource.data.appointmentDateTime is timestamp
        && (!('endDateTime' in request.resource.data)
             || request.resource.data.endDateTime >= request.resource.data.appointmentDateTime)
        && request.resource.data.updatedAt == request.time
        // author, or owner/admin of the recipient's org. A legacy record has no
        // recorded author, so it is owner/admin only (2026-11-16) — no
        // recipient-write fallback.
        && ( (('createdByUid' in resource.data)
              && resource.data.createdByUid == request.auth.uid)
             || memberHasRole(recipientOrgId(get(resource.data.careRecipientRef).id),
                              ['owner', 'admin']) );

      allow delete: if canWriteRecipientData(get(resource.data.careRecipientRef).id)
        && ( ('createdByUid' in resource.data
              && resource.data.createdByUid == request.auth.uid)
             || memberHasRole(recipientOrgId(get(resource.data.careRecipientRef).id),
                              ['owner', 'admin']) );
    }

    // ---------------------------------------------------------------------------
    // Dead collections (Q10/Q13 — explicit deny until their domains are wired).
    // Zero live data today, zero UI readers/writers; owner-only would silently
    // allow future un-audited writes through old code paths. When a domain gets
    // wired, upgrade its block to the same recipient-org gate as the live
    // collections — a one-block swap (vitalLogs 2026-11-13, waterLogs 2026-11-13
    // and appointments 2026-11-16 are the swaps done so far). The emerencyinfo
    // typo is RETAINED (§5.4).
    // ---------------------------------------------------------------------------
    match /emerencyinfo/{docId}  { allow read, write: if false; }
    match /dashboardNotes/{docId}{ allow read, write: if false; }
    match /iconname/{docId}      { allow read, write: if false; }
  }
}
