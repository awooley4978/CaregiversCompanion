rules_version = '2';
// =============================================================================
// Caregivers Companion — Firestore security rules (SECURITY PHASE 4, the flip).
//
// Source of truth: /home/team/shared/security-design-proposal.md (owner-approved
// 2026-08-16), §4.1 rules sketch + §4.2 dead collections + §4.3 write
// validation + decisions D1–D9 (§7.4/§7.5). This file implements that contract
// EXACTLY, with two mechanical adjustments that make the sketch match the app's
// ACTUAL write flows (both documented inline where they occur; neither changes
// any access decision in the approved design):
//
//   (1) users/{uid} CREATE: the sketch required `activeGroupId is string` at
//       create, but the shipped app creates the profile WITHOUT a group context
//       (phase 1 auth) and merges `activeGroupId` in later (phase 2 org
//       provisioning — a second write). The create rule therefore locks the doc
//       to request.auth.uid, requires the doc's `uid` field (when present) to
//       match, and validates `activeGroupId` against real membership whenever
//       it appears in a create or update (D1: never a standalone allow).
//   (2) organizations/{orgId}/members/{memberId} READ: the sketch allowed
//       active members + uid self-reads only, which would deny the INVITEE the
//       design's own §3.4 flow (query pending invites by email, read the invite
//       doc, accept). The read rule adds the symmetric invitee clause — exactly
//       the email match the sketch's DELETE rule already grants for declines.
//
// DEPLOYMENT STATE: this file is PREPARATION ONLY. The deployed ruleset in the
// console is still allow-all-ish and is known to DIFFER from the git history
// (behavior-probed: mealEntries is 403 in production while git allowed it).
// The flip is gated: legacy claim (§5.1(c)) + owner sign-off first. See
// docs/security/rules-deploy.md (how to flip) and docs/security/rules-rollback.md
// (2-command rollback + pre-flip checklist). DO NOT deploy this file until the
// claim has run.
//
// Entitlements separation (D8): no plan/billing/member-cap/productTier field
// appears anywhere in these rules.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // helpers: org membership
    // Active members are uid-keyed and exist only while active (revocation =
    // delete), so existence IS the active-membership check — one cheap exists().
    // ---------------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function isActiveMember(orgId) {
      return signedIn() && orgId is string && exists(memberDoc(orgId));
    }

    // Single-get membership + role check (hot paths, read-budget friendly). A
    // missing member doc yields empty data -> .data.role is null -> null in any
    // role list -> false.
    function memberHasRole(orgId, roles) {
      return signedIn() && orgId is string && get(memberDoc(orgId)).data.role in roles;
    }

    function memberRole(orgId) {
      return get(memberDoc(orgId)).data.role; // only called after isActiveMember(orgId)
    }

    function isMemberWithRole(orgId, roles) {
      return isActiveMember(orgId) && memberRole(orgId) in roles;
    }

    // ---------------------------------------------------------------------------
    // helpers: group context (D1 — activeGroupId is a REQUEST/CONTEXT SELECTOR
    // ONLY, never authorization by itself; every use below independently
    // verifies membership / share / assignment.)
    // ---------------------------------------------------------------------------
    function activeGroupId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeGroupId;
    }

    // Switching context is legal only to an org the caller actively belongs to.
    function isValidGroupContext() {
      return request.resource.data.activeGroupId is string
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.activeGroupId)/members/$(request.auth.uid));
    }

    // ---------------------------------------------------------------------------
    // helpers: recipient access (owner org + grants + assignment scoping, D6)
    // ---------------------------------------------------------------------------
    function recipientOrgId(ref) {
      return get(/databases/$(database)/documents/careRecipients/$(ref.id)).data.orgId;
    }

    function orgDoc(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function isOrgKind(orgId, kind) {
      return orgId is string && get(orgDoc(orgId)).data.kind == kind;
    }

    // Share doc: recipientShares/{recipientId}/grants/{granteeOrgId} (§3.3)
    function shareDoc(recipientId, granteeOrgId) {
      return /databases/$(database)/documents/recipientShares/$(recipientId)/grants/$(granteeOrgId);
    }

    function hasActiveShare(recipientId, granteeOrgId) {
      return granteeOrgId is string && exists(shareDoc(recipientId, granteeOrgId));
    }

    function shareLevel(recipientId, granteeOrgId) {
      return get(shareDoc(recipientId, granteeOrgId)).data.accessLevel; // null if no share
    }

    // ---------------------------------------------------------------------------
    // helpers: assignment-scoped org staff access (D6/D7)
    // Deterministic per (recipient, staff) path; the check is the caller's OWN
    // assignment. All three get()s hit the same doc -> cached, 1 read. D7 hard
    // cutoff: request.time is server time; absent bounds (core team) unbounded.
    // ---------------------------------------------------------------------------
    function assignmentDoc(recipientId) {
      return /databases/$(database)/documents/assignments/$(recipientId)/$(request.auth.uid);
    }

    function hasActiveAssignment(recipientId) {
      return get(assignmentDoc(recipientId)).data.status == 'active'
        && (!('validFrom' in get(assignmentDoc(recipientId)).data)
            || request.time >= get(assignmentDoc(recipientId)).data.validFrom)
        && (!('validUntil' in get(assignmentDoc(recipientId)).data)
            || request.time <= get(assignmentDoc(recipientId)).data.validUntil);
    }

    // Kind-branched within-org visibility (D6): family -> any active member;
    // organization -> owner/admin, or caregiver/viewer with an active assignment.
    function canAccessRecipientInOrg(ref) {
      return memberHasRole(recipientOrgId(ref), ['owner', 'admin', 'caregiver', 'viewer'])
        && ( isOrgKind(recipientOrgId(ref), 'family')
             || memberHasRole(recipientOrgId(ref), ['owner', 'admin'])
             || ( memberHasRole(recipientOrgId(ref), ['caregiver', 'viewer'])
                  && hasActiveAssignment(ref.id) ) );
    }

    // Read access: within-org (kind-branched, common case) OR grantee with an
    // active share for the caller's active group. Grants are org-wide — the
    // share branch does not consult assignments (§3.2 note).
    function canAccessRecipientRef(ref) {
      return signedIn() && ref is path
        && ( canAccessRecipientInOrg(ref)
          || hasActiveShare(ref.id, activeGroupId()) );
    }

    // Write access to recipient data: family -> member role >= caregiver;
    // organization -> owner/admin, or assigned caregiver; grantee -> share
    // accessLevel 'caregiver' (D2 default).
    function canWriteInOrg(ref) {
      return memberHasRole(recipientOrgId(ref), ['owner', 'admin', 'caregiver'])
        && ( isOrgKind(recipientOrgId(ref), 'family')
             || memberHasRole(recipientOrgId(ref), ['owner', 'admin'])
             || ( memberHasRole(recipientOrgId(ref), ['caregiver'])
                  && hasActiveAssignment(ref.id) ) );
    }

    function canWriteRecipientData(ref) {
      return signedIn() && ref is path
        && ( canWriteInOrg(ref)
          || shareLevel(ref.id, activeGroupId()) == 'caregiver' );
    }

    // ---------------------------------------------------------------------------
    // users/{uid} — self only. Adjustment (1): the create rule accepts the
    // phase-1 profile create (uid/name/email/createdAt, no context) and the
    // phase-2 set-merge that adds activeGroupId (which may be a create if the
    // profile write raced), validating context against real membership in both.
    // ---------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('activeGroupId' in request.resource.data) || isValidGroupContext());
      // Self-update; changing activeGroupId is allowed only to an org the user
      // actively belongs to (D1 — validated against the members subcollection).
      allow update: if signedIn() && request.auth.uid == uid
        && ( !('activeGroupId' in request.resource.data.diff(resource.data).affectedKeys())
             || isValidGroupContext() );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // organizations/{orgId}
    // D8: product metadata (plan, memberCap, displayName, productTier) is NOT
    // referenced anywhere — entitlements live outside authorization.
    // ---------------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isActiveMember(orgId);
      // Any signed-in user may create an org (becomes its owner via the member
      // doc below). kind is validated at create (D5: the app writes 'family').
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.kind in ['family', 'organization'];
      allow update: if isMemberWithRole(orgId, ['owner', 'admin']);
      allow delete: if isMemberWithRole(orgId, ['owner']); // owner-only transfer/delete
    }

    // ---------------------------------------------------------------------------
    // organizations/{orgId}/members/{memberId}
    // Active members keyed by uid; pending invites keyed by lowercase email with
    // status 'invited'. Adjustment (2): invitees may read invites addressed to
    // their own auth email (the design's §3.4 accept flow); the delete rule's
    // email match is the design's own decline clause.
    // ---------------------------------------------------------------------------
    match /organizations/{orgId}/members/{memberId} {
      allow read: if isActiveMember(orgId)
        || request.auth.uid == memberId
        || (resource.data.status == 'invited'
            && resource.data.invitedEmail == request.auth.token.email);
      // Founder self-doc (org doc must already exist — sequential write, §2.1);
      // owner/admin invite (role never 'owner'); invitee self-accept (role
      // locked to the invite).
      allow create: if signedIn() && (
          // founder
          (request.resource.data.uid == request.auth.uid
           && request.resource.data.role == 'owner'
           && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid)
        || // owner/admin invite
          (isMemberWithRole(orgId, ['owner', 'admin'])
           && request.resource.data.status == 'invited'
           && request.resource.data.role in ['admin', 'caregiver', 'viewer'])
        || // invitee self-accept: uid-keyed active doc, role locked to the invite
          (request.auth.uid == memberId
           && request.resource.data.uid == request.auth.uid
           && request.resource.data.status == 'active'
           && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.token.email))
           && request.resource.data.role
              == get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.token.email)).data.role)
      );
      // Owner/admin manage roles & status; admins cannot create owners.
      allow update: if isMemberWithRole(orgId, ['owner'])
        || (isMemberWithRole(orgId, ['admin']) && request.resource.data.role != 'owner');
      // Owner/admin revoke; invitee may delete own pending invite (decline /
      // accept-batch cleanup).
      allow delete: if isMemberWithRole(orgId, ['owner', 'admin'])
        || (resource.data.status == 'invited'
            && resource.data.invitedEmail == request.auth.token.email);
    }

    // ---------------------------------------------------------------------------
    // assignments/{recipientId}/{staffUid} — model-ready but EMPTY in v1 (D9).
    // Professional orgs only (D6/D7): owner/admin manage; staff read their own
    // assignment (powers the future "my recipients" collectionGroup query).
    // Write validation per §4.3.
    // ---------------------------------------------------------------------------
    match /assignments/{recipientId}/{staffUid} {
      allow read: if request.auth.uid == staffUid
        || isMemberWithRole(
             get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
             ['owner', 'admin']);
      allow create: if isMemberWithRole(
                        get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
                        ['owner', 'admin'])
        && request.resource.data.staffUid == staffUid
        && request.resource.data.orgId
           == get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId
        && isOrgKind(request.resource.data.orgId, 'organization')
        && request.resource.data.teamType in ['core', 'temporary']
        && request.resource.data.status == 'active'
        && request.resource.data.assignedBy == request.auth.uid
        && (!('validUntil' in request.resource.data)
            || request.resource.data.validUntil > request.time)
        && (!('validFrom' in request.resource.data) || !('validUntil' in request.resource.data)
            || request.resource.data.validFrom < request.resource.data.validUntil);
      // Revocation = delete (or status -> 'removed' via update); immediate
      // either way. Update is owner/admin only (D7 bounds are create-time
      // validation; time still enforced on the READ path by hasActiveAssignment).
      allow update: if isMemberWithRole(
                        get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
                        ['owner', 'admin']);
      allow delete: if isMemberWithRole(
                        get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
                        ['owner', 'admin']);
    }

    // ---------------------------------------------------------------------------
    // recipientShares/{recipientId}/grants/{granteeOrgId} — cross-group grants
    // (D4: model/rules-only, no UI yet). ONLY the owner of the recipient's org
    // creates/updates/revokes grants. Read: owner-org members only (management
    // surface, §4.1) — grantee access is granted implicitly via exists() in
    // canAccessRecipientRef.
    // ---------------------------------------------------------------------------
    match /recipientShares/{recipientId}/grants/{granteeOrgId} {
      allow read: if isActiveMember(recipientOrgId(/databases/$(database)/documents/careRecipients/$(recipientId)));
      allow create, update, delete:
        if isMemberWithRole(
             get(/databases/$(database)/documents/careRecipients/$(recipientId)).data.orgId,
             ['owner'])
          && request.resource.data.accessLevel in ['caregiver', 'viewer'];
    }

    // ---------------------------------------------------------------------------
    // careRecipients
    // ---------------------------------------------------------------------------
    match /careRecipients/{docId} {
      // Create: the writer must be an ACTIVE MEMBER of the org the doc claims
      // (D1 — rules independently verify membership via get() on the members
      // doc; activeGroupId is never a standalone allow). orgId required.
      allow create: if isActiveMember(request.resource.data.orgId)
        && request.resource.data.orgId is string;
      // Read: within-org (kind-branched, D6) or grantee via an active share.
      allow read: if canAccessRecipientRef(/databases/$(database)/documents/careRecipients/$(docId));
      // Owner-org caregiver+ (kind-branched) or caregiver-level grantee;
      // orgId is immutable under rules (§4.3) — no transfer in v1 (grants are
      // the v1 mechanism for provider access).
      allow update: if request.resource.data.orgId == resource.data.orgId
        && canWriteRecipientData(/databases/$(database)/documents/careRecipients/$(docId));
      // Q5: delete = owner of the recipient's org only.
      allow delete: if isMemberWithRole(resource.data.orgId, ['owner']);
    }

    // ---------------------------------------------------------------------------
    // carechecklist (subcollection of careRecipients)
    // NOTE: the old collectionGroup catch-all
    //   match /{path=**}/carechecklist/{document} { allow read: if true; }
    // is REMOVED — it bypassed the parent-org gate. Access derives from the
    // PARENT recipient doc.
    // ---------------------------------------------------------------------------
    match /careRecipients/{parent}/carechecklist/{docId} {
      function parentRef() {
        return /databases/$(database)/documents/careRecipients/$(parent);
      }
      allow read:   if canAccessRecipientRef(parentRef());
      allow create: if canWriteRecipientData(parentRef());
      allow update, delete:
        if canWriteRecipientData(parentRef());
    }

    // ---------------------------------------------------------------------------
    // careNotes — ref-linked via careRecipientRef
    // ---------------------------------------------------------------------------
    match /careNotes/{docId} {
      allow read:   if canAccessRecipientRef(resource.data.careRecipientRef);
      allow create: if canWriteRecipientData(request.resource.data.careRecipientRef);
      allow update, delete:
        if canWriteRecipientData(resource.data.careRecipientRef);
    }

    // ---------------------------------------------------------------------------
    // mealEntries — ref-linked via patientRef
    // ---------------------------------------------------------------------------
    match /mealEntries/{docId} {
      allow read:   if canAccessRecipientRef(resource.data.patientRef);
      allow create: if canWriteRecipientData(request.resource.data.patientRef);
      allow update, delete:
        if canWriteRecipientData(resource.data.patientRef);
    }

    // ---------------------------------------------------------------------------
    // symptomEntries — ref-linked via patientRef
    // ---------------------------------------------------------------------------
    match /symptomEntries/{docId} {
      allow read:   if canAccessRecipientRef(resource.data.patientRef);
      allow create: if canWriteRecipientData(request.resource.data.patientRef);
      allow update, delete:
        if canWriteRecipientData(resource.data.patientRef);
    }

    // ---------------------------------------------------------------------------
    // Dead collections (Q10/Q13 — explicit deny until their domains are wired).
    // Zero live data today, zero UI readers/writers; owner-only would silently
    // allow future un-audited writes through old code paths. When a domain gets
    // wired, upgrade its block to the same recipient-org gate as the live
    // collections — a one-block swap. The emerencyinfo typo is RETAINED (§5.4).
    // ---------------------------------------------------------------------------
    match /emerencyinfo/{docId}  { allow read, write: if false; }
    match /medications/{docId}   { allow read, write: if false; }
    match /vitalLogs/{docId}     { allow read, write: if false; }
    match /appointments/{docId}  { allow read, write: if false; }
    match /dashboardNotes/{docId}{ allow read, write: if false; }
    match /iconname/{docId}      { allow read, write: if false; }
  }
}
